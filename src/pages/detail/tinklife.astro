---
import { Image } from "astro:assets";
import DetailPostLayout from "../../layouts/DetailPostLayout.astro";
import PostHeader from "../../components/PostHeader.astro";
const images = Object.values(
	import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/travel/*.{jpg,png,webp}', {
		eager: true,
	})
);
// Importa el componente Image y las imágenes
---
<DetailPostLayout
	title="Tink Life | Diseño de inspiración | Rico"
	description = 'RICO & TINK: DIARY LIFE, sitio móvil. Proyecto desarrollado personalmente, responsable de todo el prototipo, diseño, desarrollo, lanzamiento y mantenimiento.',
	keywords = 'RICO & TINK: DIARY LIFE, registro de vida',
>
	<div class="post">
		<main class="post-wrapper">
				<PostHeader
					tag="Project"
					description="">
						<h1 class="font-type">
							Rico & Tink: Diary Life
						</h1>
				</PostHeader>
				<div class="content">
					<div class="row desc">
						<div class="col-1a">
							<h3 class="post-title">Selección de herramientas técnicas: Figma & Vue</h3>
							<p class="post-desc">
								Sitio móvil. Proyecto desarrollado de forma independiente, con responsabilidad total sobre el prototipado, el diseño, el desarrollo, el lanzamiento y el mantenimiento.
							</p>
						</div>
					</div>
				</div>
			</section>
			<section class="preview">
				{images.map((img, index) => (
					<picture class="picture">
					  <Image src={img.default} alt={`Image ${index + 1}`}   loading="lazy" decoding="async" />
					</picture>
				  ))}
			</section>
		</main>
	</div>
</DetailPostLayout>

<style>
.icon{
	color:var(--color-900);
}
</style>

<script>
	var images = document.getElementsByTagName('img');
 	for (var i = 0; i < images.length; i++) {
	// Añade draggable="false" a cada etiqueta img
	images[i].setAttribute('draggable', 'false');
	images[i].setAttribute('ref', 'nofollow');
  }
</script>
