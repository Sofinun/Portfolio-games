---
import { Image } from "astro:assets";
import DetailHeader from "../../components/DetailHeader.astro";
import DetailPostLayout from "../../layouts/DetailPostLayout.astro";
import CallToAction from "../../components/CallToAction.astro";

// Ingresa la ruta de la carpeta; cargará todos los archivos por nombre y los convertirá a webp.
const images = Object.values(
	import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/todo/*.{jpg,png,webp}', {
		eager: true,
	})
);

---
<DetailPostLayout
	title="Todo List Online | 606 Diseño de inspiración | Rico"
	description = 'Aplicación web TodoList de diseño minimalista, sin registro, datos almacenados en caché local H5 del navegador, con soporte para trabajo y vida.',
	keywords = 'Todo en línea, todo list web, memo, sin registro, listo para usar, notas, recordatorio, agenda, cuaderno, notas, eventos pendientes, online todolist, 606 diseño',
>
	<div class="post">
		<main class="post-wrapper">
			<DetailHeader
			tag="WEBSITE"
			description="">
					<h1 class="font-type">
						Todo List Online
					</h1>
			</DetailHeader>

			<section>
				<div class="content">
					<div class="row desc">
						<div class="col-1a">
							<h3 class="post-title">Todo 1.0 - Figma & Vue 2.x</h3>
							<p class="post-desc">
								Una aplicación web TodoList bien diseñada y minimalista, sin necesidad de registro, con datos guardados en el almacenamiento local del navegador. Basada en Vue 2.x, ofrece apoyo tanto para el trabajo como para la vida diaria.
							</p>
						</div>
						<div class="col-1a">
							<p>
								<div class="btn">
									<CallToAction href="https://todo.uiineed.com/" target="_blank">
										Visitar sitio
									</CallToAction>
									<CallToAction href="https://github.com/ricocc/uiineed-todo-list" target="_blank">
										Github
									</CallToAction>
								</div>
							</p>
						</div>
					</div>
				</div>
			</section>
			<section class="preview">
				{images.map((img, index) => (
					<picture class="gsap-picture">
					  <Image src={img.default} alt={`Image ${index + 1}`}   loading="lazy" decoding="async" />
					</picture>
				  ))}
			</section>
		</main>
	</div>
</DetailPostLayout>

<style>
img{
	border:1px solid #ececec;
}
.btn{
	display: flex;
	gap: 16px;
}
</style>
